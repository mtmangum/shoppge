    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.30.0",
    "lucide-react": "^0.383.0",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.19",
    "nodemailer": "^6.9.0",
    "pg": "^8.11.0",
