# Copy to .env and fill in values before running

# App
NEXTAUTH_URL=https://shop.pge.utexas.edu
NEXTAUTH_SECRET=                          # run: openssl rand -base64 32
AUTH_TRUST_HOST=true                      # required by NextAuth v5 for any self-hosted deployment
                                           # (not auto-detected outside a few known platforms)

# Database
DATABASE_URL=postgresql://pgeshop:CHANGE_ME@localhost:5432/pge_shop
DB_PASSWORD=CHANGE_ME

# File storage (MinIO / S3-compatible)
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are what the app itself uses to talk
# to S3 (real IAM keys in AWS deployments). Leave S3_ENDPOINT unset to hit
# real AWS S3; set it to point at MinIO for local dev.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pge-shop-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=CHANGE_ME

# MinIO container's own superuser creds (local dev only, self-hosted MinIO).
# Match these to S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY above so the app can
# authenticate against the MinIO instance docker-compose brings up.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# Email (UT SMTP relay)
SMTP_HOST=smtp.utexas.edu
SMTP_PORT=587
SMTP_FROM=pge-shop@utexas.edu
SMTP_USER=                                # UT service account if required
SMTP_PASS=

# For local dev email testing, run Mailpit instead of hitting the real relay:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# Then set:
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# and open http://localhost:8025 to see captured emails.

# Phase 2: UT Shibboleth SSO (leave blank until ready)
SAML_CLIENT_ID=
SAML_CLIENT_SECRET=
